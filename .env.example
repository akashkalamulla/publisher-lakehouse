# PostgreSQL is the development target. There is no SQLite fallback: if this
# URL is missing or wrong, the run fails rather than writing its manifest
# somewhere else.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/publisher_lakehouse
DATA_DIR=data
LOG_LEVEL=INFO
CAPTURE_FIXTURES=0

# S3 API endpoint and local object-store (RustFS) credentials. Choose your own keys; the
# secret must have at least eight characters.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=YOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_KEY_AT_LEAST_8_CHARACTERS
LAKE_BUCKET=lakehouse

# Separate analytical warehouse on localhost:5433. Set these in the local .env.
WAREHOUSE_DB=publisher_warehouse
WAREHOUSE_USER=warehouse_app
WAREHOUSE_PASSWORD=CHOOSE_A_STRONG_WAREHOUSE_PASSWORD
GRAFANA_DB_PASSWORD=CHOOSE_A_DIFFERENT_STRONG_READONLY_PASSWORD

# Grafana login; applied only when its grafana-data volume is first created.
GRAFANA_ADMIN_USER=CHOOSE_A_GRAFANA_ADMIN_USER
GRAFANA_ADMIN_PASSWORD=CHOOSE_A_STRONG_GRAFANA_ADMIN_PASSWORD

# Only for the manifest integration tests. Must be a separate database from
# the one above: the tests drop and recreate the schema.
# PL_TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/publisher_lakehouse_test
