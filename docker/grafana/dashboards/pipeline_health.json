{
  "id": null,
  "uid": "pl-pipeline-health",
  "title": "Pipeline health",
  "tags": [
    "publisher-lakehouse"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 0,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Lake tables",
      "description": "Which Delta tables were last published, with their versions, row counts, and commit ages?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT layer,\n       table_name,\n       delta_version,\n       row_count,\n       last_commit_at,\n       ROUND((EXTRACT(EPOCH FROM now() - last_commit_at) / 3600)::numeric, 1) AS age_hours\nFROM ops.layer_status\nORDER BY layer, table_name",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last successful publish",
      "description": "How long has it been since the latest successful warehouse publish?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT MAX(finished_at) AS last_successful_publish\nFROM ops.publish_log\nWHERE status = 'success'",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last publish status",
      "description": "Did the most recently started publish succeed or fail?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT status\nFROM ops.publish_log\nORDER BY started_at DESC, publish_id DESC\nLIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "success": {
                  "text": "success",
                  "color": "green"
                },
                "failed": {
                  "text": "failed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Publish history",
      "description": "What happened in the last twenty warehouse publish attempts?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT publish_id,\n       status,\n       started_at,\n       finished_at,\n       ROUND(EXTRACT(EPOCH FROM finished_at - started_at)::numeric, 1) AS duration_seconds,\n       error\nFROM ops.publish_log\nORDER BY started_at DESC, publish_id DESC\nLIMIT 20",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Rows per lake table",
      "description": "How many rows were in each lake table at its last published Delta version?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT layer || '/' || table_name AS lake_table,\n       row_count\nFROM ops.layer_status\nORDER BY layer, table_name",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "lake_table",
        "showValue": "always"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Scraper health",
      "description": "Is the Windows scraper running on schedule, and what state does its manifest report?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Last scrape finished",
      "description": "How long ago did the most recently recorded scrape run finish?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT MAX(finished_at) AS last_scrape_finished\nFROM ops.scrape_runs",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^last_scrape_finished$/",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Last run status",
      "description": "Did the latest recorded scrape run log its completion event, and what was the ingest exit code?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT status,\n       ingest_exit_code\nFROM ops.scrape_runs\nORDER BY finished_at DESC NULLS LAST, pushed_at DESC\nLIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "complete": {
                        "text": "complete",
                        "color": "green"
                      },
                      "incomplete": {
                        "text": "incomplete",
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ingest_exit_code"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Ingest exit code"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "0",
                        "color": "green"
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 255,
                      "result": {
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "unknown"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Last 10 runs",
      "description": "What did each of the last ten scrape runs discover, fetch, write, skip, and fail?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT run_id,\n       finished_at,\n       status,\n       ingest_exit_code,\n       articles_discovered,\n       fetched,\n       bronze_written,\n       skipped_manifest,\n       fetch_failed,\n       blocked_gave_up,\n       parse_failed\nFROM ops.scrape_runs\nORDER BY finished_at DESC NULLS LAST, run_id DESC\nLIMIT 10",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 330
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "finished_at"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "complete": {
                        "text": "complete",
                        "color": "green"
                      },
                      "incomplete": {
                        "text": "incomplete",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fetch_failed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "blocked_gave_up"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "parse_failed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Manifest rows by type and status",
      "description": "How many manifest URLs are in each URL type and terminal status?",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 51
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT url_type || ' / ' || status AS type_status,\n       SUM(row_count) AS manifest_rows\nFROM ops.scrape_status\nGROUP BY url_type, status\nORDER BY url_type, status",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "type_status",
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Journals needing attention",
      "description": "Which journal pages are not ok or unseen for seven days, oldest first? The table is empty when none are.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 59
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "refId": "A",
          "rawSql": "SELECT publisher,\n       journal_url,\n       status,\n       last_seen_at,\n       ROUND((EXTRACT(EPOCH FROM now() - last_seen_at) / 86400)::numeric, 1) AS days_since_seen,\n       last_changed_at,\n       last_http_status,\n       fetch_count,\n       last_run_id\nFROM ops.scrape_journals\nWHERE status <> 'ok'\n   OR last_seen_at < now() - interval '7 days'\nORDER BY last_seen_at ASC NULLS FIRST, journal_url",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
